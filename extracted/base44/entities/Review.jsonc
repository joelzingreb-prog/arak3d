{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID du produit concern\u00e9"
    },
    "product_name": {
      "type": "string",
      "description": "Nom du produit (snapshot)"
    },
    "author_name": {
      "type": "string",
      "description": "Pr\u00e9nom ou pseudo du client"
    },
    "rating": {
      "type": "number",
      "description": "Note de 1 \u00e0 5"
    },
    "comment": {
      "type": "string",
      "description": "Commentaire texte"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Mis en avant sur la page d'accueil"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "author_name",
    "rating"
  ]
}