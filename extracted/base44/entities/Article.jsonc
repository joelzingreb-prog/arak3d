{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'article"
    },
    "author": {
      "type": "string",
      "description": "Nom de l'auteur / \u00e9diteur"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure de publication"
    },
    "content": {
      "type": "string",
      "description": "Contenu principal de l'article (texte)"
    },
    "image_url": {
      "type": "string",
      "description": "Image principale de l'article"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Images suppl\u00e9mentaires"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Afficher l'article sur la page"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordre d'affichage"
    }
  },
  "required": [
    "title",
    "author"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}